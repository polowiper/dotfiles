/*
  IDA Pro 9.4

  Notes for first use:

    * IDA 9.4 expects the exact CPython version it was built against. The
      required version is embedded in the ELF as `Py_Version` and is currently
      3.14.7; `idapyswitch` refuses any other version. nixpkgs' `python3` is
      3.14.x and is wired up from the wrappers below.

    * On the very first launch IDA shows the Hex-Rays EULA/license dialog.
      Accept it once; IDA stores the acceptance in ~/.idapro/ida.reg. This
      acceptance is also a prerequisite for batch mode and idalib
      ("License not yet accepted, cannot run in batch mode").

    * The license (idapro.hexlic) is generated by kg_patch/keygen.js during the
      build and is passed to IDA through the IDA_LICENSE environment variable.
      This is what keeps the license working across rebuilds, since the nix
      store path (and therefore the path recorded in the registry) changes.

    * This uses the *official* Hex-Rays MCP server
      (https://github.com/HexRaysSA/ida-mcp). Its GUI plugin is installed into
      $out/opt/plugins/ida-mcp and the `ida-mcp` MCP server binary is wrapped
      for use by agent harnesses.
*/
{
  autoPatchelfHook,
  cairo,
  copyDesktopItems,
  nodejs,
  tree,
  dbus,
  fetchFromGitHub,
  fetchurl,
  fontconfig,
  freetype,
  glib,
  gtk3,
  lib,
  libdrm,
  libGL,
  libkrb5,
  libsecret,
  libunwind,
  libxkbcommon,
  libXtst,
  makeDesktopItem,
  makeWrapper,
  openssl,
  python3,
  stdenv,
  util-linux,
  xcb-util-cursor,
  zlib,
  libICE,
  libSM,
  libX11,
  libXau,
  libxcb,
  libXext,
  libXi,
  libXrender,
  xcbutilimage,
  xcbutilkeysyms,
  xcbutilrenderutil,
  xcbutilwm,
  xcbutil,
  ...
}: let
  # Derive the Python package set from the *passed* `python3` so the packages
  # and the `withPackages` environments always use the same interpreter.
  # (`python3Packages` would silently keep using pkgs' default interpreter and
  # mix, e.g., 3.14 packages into a 3.13 environment.)
  pythonPackages = python3.pkgs;

  # ------------------------------------------------------------------
  # Official Hex-Rays IDA MCP (https://github.com/HexRaysSA/ida-mcp)
  # and its dependency chain. None of these are packaged in nixpkgs (yet),
  # so they are built from PyPI/GitHub here.
  # ------------------------------------------------------------------
  idaMcpSrc = fetchFromGitHub {
    owner = "HexRaysSA";
    repo = "ida-mcp";
    rev = "df6de7985b534a964c125d5a86e41b26b17b14f6";
    sha256 = "0psfjalaalvr8n6y5bpiqj1g0q2bxp25ka4bnnvks9bprssz6pp1";
  };

  # `idapro` is the idalib Python loader. The wheel bundled with the IDA 9.4
  # installer is 0.0.9 while `ida-domain` requires >=0.0.10; PyPI's 0.0.11 is
  # the same code, so use that.
  idaproPy = pythonPackages.buildPythonPackage rec {
    pname = "idapro";
    version = "0.0.11";
    format = "setuptools";
    src = fetchurl {
      url = "https://files.pythonhosted.org/packages/22/32/e9038bf47fb9cf4cd8dd85d63aa32bdeaab20a1659a64030b506028c1ec5/idapro-0.0.11.tar.gz";
      sha256 = "0kgx56k5anhx15r56fc127wq19csfvyingqgxn1b0j1f86gjbk02";
    };
    doCheck = false;
  };

  zeromcpPy = pythonPackages.buildPythonPackage rec {
    pname = "zeromcp";
    version = "1.10.3";
    pyproject = true;
    src = fetchurl {
      url = "https://files.pythonhosted.org/packages/12/d4/8c08a915315542433db6e6f9fe28078412f0488c71648feb12fff43b8aa7/zeromcp-1.10.3.tar.gz";
      sha256 = "1rmsmjn7241xsbzhgpmvbbpzdbs9i2s1rbhh7cpf1qrjs6r1s8vi";
    };
    sourceRoot = "zeromcp-1.10.3";
    build-system = [pythonPackages.hatchling];
    doCheck = false;
  };

  idaDomainPy = pythonPackages.buildPythonPackage rec {
    pname = "ida-domain";
    version = "0.5.1";
    pyproject = true;
    src = fetchurl {
      url = "https://files.pythonhosted.org/packages/80/34/be087d3ea1c3a6573e0660cb5b40f0c4ade9ae5772cf1c5d98d52472d28b/ida_domain-0.5.1.tar.gz";
      sha256 = "0vyi6rjlv9aag4xm7fik7f82fgwsf05balgnaklq5n27f10jr7y4";
    };
    sourceRoot = "ida_domain-0.5.1";
    build-system = [pythonPackages.hatchling];
    dependencies = [
      idaproPy
      pythonPackages.packaging
      pythonPackages.typing-extensions
    ];
    doCheck = false;
    dontCheckRuntimeDeps = true;
  };

  idaNexusPy = pythonPackages.buildPythonPackage rec {
    pname = "ida-nexus";
    version = "0.13.4";
    pyproject = true;
    src = fetchurl {
      url = "https://files.pythonhosted.org/packages/f9/87/834d0c5b6bdaadcb477822eb0755ebfa57a1543c8809baf6f893ffc2b5d2/ida_nexus-0.13.4.tar.gz";
      sha256 = "1c5bbdjjfzmyabjx52fhg04m2pnw7sv3jihdnl376y3qyhrdf3w5";
    };
    sourceRoot = "ida_nexus-0.13.4";
    build-system = [pythonPackages.hatchling];
    dependencies = [idaDomainPy];
    doCheck = false;
    dontCheckRuntimeDeps = true;
  };

  idaMcpPy = pythonPackages.buildPythonPackage rec {
    pname = "ida-mcp";
    version = "20261008.0.1";
    pyproject = true;
    src = idaMcpSrc;
    build-system = [pythonPackages.hatchling];
    dependencies = [
      idaNexusPy
      zeromcpPy
      pythonPackages.packaging
    ];
    doCheck = false;
    dontCheckRuntimeDeps = true;
  };

  # Python environment for the MCP *server* process, which runs outside IDA
  # and talks to the GUI plugin / idalib workers over IDA Nexus.
  idaMcpPython = python3.withPackages (ps: [
    idaMcpPy
    idaNexusPy
    idaDomainPy
    idaproPy
    zeromcpPy
    ps.packaging
    ps.typing-extensions
  ]);

  # Python environment exposed to IDA's embedded interpreter. Provides the
  # optional dependencies Diaphora uses for its ML-based heuristics, as well as
  # the `ida-nexus`/`ida-domain` stack required by the official MCP GUI plugin.
  idaPython = python3.withPackages (ps: [
    ps.numpy
    ps.pandas
    ps.scikit-learn
    ps.joblib
    idaNexusPy
    idaDomainPy
    idaproPy
    ps.packaging
    ps.typing-extensions
  ]);

  idaSitePackages = "${idaPython}/${python3.sitePackages}";

  # The Lumina / HexVault / HexLicense servers are shipped as separate
  # BitRock installers that unconditionally refuse to run unless euid == 0.
  # Enter a user namespace where we are mapped to root, which satisfies the
  # check without needing any real privileges. `--initialization 0
  # --service 0` skips the user/systemd/database setup that has no business
  # happening inside a nix build.
  installHexRaysServer = runfile: prefix: ''
    mkdir -p ${prefix}
    unshare -r "$(cat $NIX_CC/nix-support/dynamic-linker)" ${runfile} \
      --mode unattended \
      --prefix ${prefix} \
      --initialization 0 \
      --service 0

    # The uninstaller is a ~6 MiB blob tied to a real installation prefix and
    # is useless once the files live in the nix store.
    rm -f ${prefix}/uninstall ${prefix}/uninstall.dat
  '';
in
  stdenv.mkDerivation rec {
    pname = "ida-pro";
    version = "9.4";

    src = ./ida-pro_94_x64linux.run;

    diaphoraSrc = fetchFromGitHub {
      owner = "joxeankoret";
      repo = "diaphora";
      rev = "3.4.2";
      sha256 = "0m3zhq62cd1i9wb3pdrirgmd1gfaq2kszsr1ah0y6y79dj8bvkx3";
    };

    icon = fetchurl {
      urls = [
        "https://web.archive.org/web/20221105181235im_/https://hex-rays.com/products/ida/news/8_1/images/icon_teams.png"
      ];
      hash = "sha256-gjb999iszr6gqlJJjMJ6mMU8EJHbOSgIdFfbgUx8hkM=";
    };

    desktopItem = makeDesktopItem {
      name = "ida-pro";
      exec = "ida";
      icon = icon;
      comment = "Interactive disassembler and debugger";
      desktopName = "IDA Pro 9.4";
      genericName = "Interactive Disassembler";
      categories = ["Development"];
      startupWMClass = "IDA";
    };

    desktopItems = [desktopItem];

    nativeBuildInputs = [
      tree
      makeWrapper
      copyDesktopItems
      autoPatchelfHook
      nodejs
      # Provides `unshare`, used to run the root-only Hex-Rays server installers
      # inside a user namespace during the build.
      util-linux
    ];

    # Configure autoPatchelfHook to ignore Qt6 libraries that IDA ships with
    # because SOMEHOW it gives fuckass errors.
    #
    # NOTE: IDA 9.4 now ships libQt6Network.so.6 (needed by the built-in Lumina
    # and Teams clients) so it no longer has to be ignored here.
    autoPatchelfIgnoreMissingDeps = [
      "libQt6WaylandCompositor.so.6"
      "libQt6EglFSDeviceIntegration.so.6"
      "libQt6WlShellIntegration.so.6"
      "libQt6Core.so.6"
      "libQt6Gui.so.6"
      "libQt6Widgets.so.6"
      "libpython3.*\\.so"
    ];

    # We just get a runfile in $src, so no need to unpack it.
    dontUnpack = true;

    # Add only essential system libraries that IDA doesn't ship with.
    # IDA Pro 9.4 ships with its own Qt6 libraries, so fuck Qt6.
    runtimeDependencies = [
      cairo
      dbus
      fontconfig
      freetype
      glib
      gtk3
      libdrm
      libGL
      libkrb5
      libsecret
      libunwind
      libxkbcommon
      libXtst
      openssl
      python3
      stdenv.cc.cc
      libICE
      libSM
      libX11
      libXau
      libxcb
      libXext
      libXi
      libXrender
      xcbutilimage
      xcbutilkeysyms
      xcbutilrenderutil
      xcbutilwm
      xcbutil
      xcb-util-cursor
      zlib
    ];
    buildInputs = runtimeDependencies;

    dontWrapQtApps = true;

    installPhase = ''
      runHook preInstall

      mkdir -p $out/bin $out/lib $out/opt $out/share/applications

      # IDA depends on quite some things extracted by the runfile, so first extract everything
      # into $out/opt, then remove the unnecessary files and directories.
      IDADIR=$out/opt

      export XDG_DATA_HOME=$out/share

      # Invoke the installer with the dynamic loader directly, avoiding the need
      # to copy it to fix permissions and patch the executable.
      $(cat $NIX_CC/nix-support/dynamic-linker) $src \
        --mode unattended --prefix $IDADIR

      # Copy the Node.js keygen to the installation directory
      cp ${./kg_patch/keygen.js} $IDADIR/keygen.js

      # Run the Node.js keygen to generate the license and patch the IDA core
      # libraries. Licenses from before 9.4 no longer work, the 9.4 keygen is
      # not interchangeable with the 9.2 one.
      ( cd $IDADIR && node keygen.js )

      # Make sure the license was actually generated
      if [ -f $IDADIR/idapro.hexlic ]; then
        echo "License generated successfully"
      else
        echo "ERROR: License generation failed"
        exit 1
      fi

      # Copy the (patched) libraries to the lib directory
      cp $IDADIR/libida.so $out/lib
      cp $IDADIR/libida32.so $out/lib

      # Some libraries come with the installer.
      addAutoPatchelfSearchPath $IDADIR

      # ------------------------------------------------------------------
      # IDA 9.4 add-ons: Lumina / HexVault / HexLicense servers
      # ------------------------------------------------------------------
      ${installHexRaysServer ./misc/lumina94_x64linux.run "$out/opt/lumina"}
      ${installHexRaysServer ./misc/hexvault94_x64linux.run "$out/opt/hexvault"}
      ${installHexRaysServer ./misc/hexlicsrv94_x64linux.run "$out/opt/hexlicsrv"}

      # Their bundled MySQL client has to stay next to the server binaries.
      addAutoPatchelfSearchPath $out/opt/lumina
      addAutoPatchelfSearchPath $out/opt/hexvault
      addAutoPatchelfSearchPath $out/opt/hexlicsrv

      # ------------------------------------------------------------------
      # Wrappers
      # ------------------------------------------------------------------
      # IDA itself (GUI + text mode) needs the embedded Python wired up.
      #
      # NOTE: IDA 9.4 embeds the exact CPython version it was built against
      # (`Py_Version` in the ELF is 3.14.7) and idapyswitch refuses anything
      # else. nixpkgs' `python3` is 3.14.x, which is why it is passed here.
      #
      # NOTE: the license is forced via IDA_LICENSE so that a rebuild (which
      # changes the store path, and GCs the old one) cannot leave IDA pointing
      # at a stale/removed idapro.hexlic registered in ~/.idapro/ida.reg.
      #
      # NOTE: deliberately no `--chdir $IDADIR` here: it would make IDA resolve
      # relative input paths against the installation directory.
      for bb in ida idat; do
        if [ -f $IDADIR/$bb ]; then
          makeWrapper $IDADIR/$bb $out/bin/$bb \
            --prefix LD_LIBRARY_PATH : $IDADIR:${python3}/lib \
            --prefix PYTHONPATH : $IDADIR/opt/python:${idaSitePackages} \
            --set QT_PLUGIN_PATH $IDADIR/plugins/platforms \
            --set IDA_LICENSE "keyfile=$IDADIR/idapro.hexlic" \
            --run "$IDADIR/idapyswitch --force-path \$(ls ${python3}/lib/libpython3.*.so.1.0 | head -n 1) >/dev/null 2>&1 || true"
        fi
      done

      # Standalone clients shipped with 9.4: `lc` (Lumina client), `hv`
      # (HexVault client) and `lsadm` (license server admin).
      for bb in lc hv lsadm; do
        if [ -f $IDADIR/$bb ]; then
          makeWrapper $IDADIR/$bb $out/bin/$bb \
            --prefix LD_LIBRARY_PATH : $IDADIR \
            --chdir $IDADIR
        fi
      done

      # Server daemons extracted above. Each one keeps its bundled
      # libmysqlclient.so in its own directory.
      for srv in lumina_server vault_server license_server; do
        case "$srv" in
          lumina_server)  sdir=$out/opt/lumina ;;
          vault_server)   sdir=$out/opt/hexvault ;;
          license_server) sdir=$out/opt/hexlicsrv ;;
        esac
        if [ -f "$sdir/$srv" ]; then
          makeWrapper "$sdir/$srv" "$out/bin/$srv" \
            --prefix LD_LIBRARY_PATH : "$sdir" \
            --chdir "$sdir"
        fi
      done

      # ------------------------------------------------------------------
      # Official Hex-Rays IDA MCP server (https://github.com/HexRaysSA/ida-mcp)
      # ------------------------------------------------------------------
      # `ida-mcp` runs outside IDA and speaks MCP to the agent harness. It
      # needs IDADIR so the bundled `idapro`/idalib loader can find libidalib.
      # Invoke the entry point through the environment interpreter instead of
      # the generated console script, so this also works on nixpkgs revisions
      # whose `withPackages` environment does not re-export package binaries.
      mkdir -p $out/share/ida-mcp
      printf '%s\n' 'import sys' 'from ida_mcp.cli import main' 'sys.exit(main())' \
        > $out/share/ida-mcp/ida-mcp.py
      makeWrapper ${idaMcpPython}/bin/python $out/bin/ida-mcp \
        --add-flags "$out/share/ida-mcp/ida-mcp.py" \
        --set IDADIR $IDADIR \
        --prefix LD_LIBRARY_PATH : $IDADIR:$out/lib

      # ------------------------------------------------------------------
      # Fix IDAPython runtime
      # ------------------------------------------------------------------
      mkdir -p $IDADIR/opt/python/lib-dynload
      ln -s ${python3}/lib/libpython*.so $IDADIR/opt/python/
      ln -s ${python3}/lib/libpython3*m.so $IDADIR/opt/python/
      ln -s ${python3}/lib/python*/lib-dynload $IDADIR/opt/python/lib-dynload/

      # runtimeDependencies don't get added to non-executables, and openssl is
      # needed for cloud decompilation (lumina)
      if [ -f $IDADIR/libida.so ]; then
        patchelf --add-needed libcrypto.so $IDADIR/libida.so
      fi
      if [ -f $IDADIR/libida64.so ]; then
        patchelf --add-needed libcrypto.so $IDADIR/libida64.so
      fi

      # ------------------------------------------------------------------
      # Plugins
      # ------------------------------------------------------------------
      mkdir -p $IDADIR/plugins

      # Official IDA MCP GUI plugin. It is a plugin *directory* (ida-plugin.json
      # declares the entry point) that IDA scans and loads. The `ida_nexus`
      # package it imports comes from `idaPython` via PYTHONPATH.
      mkdir -p $IDADIR/plugins/ida-mcp
      cp ${idaMcpSrc}/ida_mcp_plugin.py $IDADIR/plugins/ida-mcp/
      cp ${idaMcpSrc}/ida-plugin.json $IDADIR/plugins/ida-mcp/

      # Install the Diaphora diffing plugin. It ships as a self-contained
      # plugin directory (ida-plugin.json + entry point), which IDA scans
      # and loads from the plugins folder, mirroring `hcli plugin install`.
      cp -r ${diaphoraSrc} $IDADIR/plugins/diaphora
      chmod -R u+w $IDADIR/plugins/diaphora

      # The tester directory only holds development fixtures (including
      # prebuilt ELF samples) that autoPatchelfHook would otherwise try to
      # patch, so drop it from the installed plugin.
      rm -rf $IDADIR/plugins/diaphora/tester

      # Copy remaining plugin files from the local plugins folder
      for f in ${./plugins}/*; do
        cp -r "$f" $IDADIR/plugins/
      done

      runHook postInstall
    '';

    meta = with lib; {
      description = "Interactive Disassembler Pro ${version}";
      homepage = "https://hex-rays.com/ida-pro/";
      license = licenses.unfree;
      platforms = platforms.linux;
      maintainers = [];
    };
  }
